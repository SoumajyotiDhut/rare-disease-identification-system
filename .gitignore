# Run in your project root
@"
# Model files — too large for git
*.pt
*.pth
*.onnx
*.pkl
*.h5
*.bin

# Never commit node_modules
node_modules/
frontend/node_modules/

# Python cache
__pycache__/
*.pyc

# Database
*.db

# Env
.env
venv/
"@ | Out-File -FilePath ".gitignore" -Encoding utf8

Write-Host "✅ .gitignore created"
backend/upload_*.py
backend/*token*
.env

backend/upload_*.py

# Allow small sklearn models
!backend/models/tfidf_vectorizer.pkl
!backend/models/lr_symptoms_model.pkl
!backend/models/label_encoder_symptoms.pkl
